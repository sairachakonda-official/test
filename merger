import duckdb
import psutil
import time
import os
import threading


class DuckDBMerger:

    def __init__(
        self,
        memory_usage_percent=70,
        threads=None,
        temp_directory="duckdb_temp",
        verbose=True
    ):

        self.memory_usage_percent=memory_usage_percent
        self.threads=threads if threads else max(os.cpu_count()-1,1)
        self.temp_directory=temp_directory
        self.verbose=verbose

        available_gb=psutil.virtual_memory().available/(1024**3)
        usable_gb=max(int(available_gb*memory_usage_percent/100),1)

        self.memory_limit=f"{usable_gb}GB"

        os.makedirs(temp_directory,exist_ok=True)

        self.max_memory_used=0

    # =====================================================
    # CONDITIONAL PRINT
    # =====================================================

    def log(self,*args,**kwargs):

        if self.verbose:
            print(*args,**kwargs)

    # =====================================================
    # FILE READER
    # =====================================================

    def get_reader(self,file_path,file_type,delimiter=None):

        file_type=file_type.lower()

        if file_type=="txt":

            delimiter=delimiter or "\t"

            return f"""
            read_csv_auto(
                '{file_path}',
                sep='{delimiter}',
                header=true,
                ignore_errors=true,
                sample_size=200000
            )
            """

        if file_type=="csv":

            delimiter=delimiter or ","

            return f"""
            read_csv_auto(
                '{file_path}',
                sep='{delimiter}',
                header=true,
                ignore_errors=true,
                sample_size=200000
            )
            """

        if file_type=="parquet":

            return f"read_parquet('{file_path}')"

        raise ValueError(
            "Supported types: csv, txt, parquet"
        )

    # =====================================================
    # CONNECTION
    # =====================================================

    def connect(self):

        con=duckdb.connect()

        con.execute(f"SET memory_limit='{self.memory_limit}'")
        con.execute(f"SET threads={self.threads}")
        con.execute(f"SET temp_directory='{self.temp_directory}'")

        return con

    # =====================================================
    # STATS
    # =====================================================

    def stats(self):

        process=psutil.Process(os.getpid())

        return {
            "CPU %":psutil.cpu_percent(interval=1),
            "Process RAM GB":process.memory_info().rss/(1024**3),
            "Available RAM GB":psutil.virtual_memory().available/(1024**3)
        }

    # =====================================================
    # MEMORY MONITOR
    # =====================================================

    def monitor_memory(self,stop_event):

        process=psutil.Process(os.getpid())

        while not stop_event.is_set():

            current_memory=(
                process.memory_info().rss
                /(1024**3)
            )

            if current_memory>self.max_memory_used:
                self.max_memory_used=current_memory

            time.sleep(0.5)

    # =====================================================
    # MERGE
    # =====================================================

    def merge(
        self,
        left_file,
        right_file,
        output_file,
        left_join_key,
        right_join_key,
        join_type="LEFT",
        left_file_type="csv",
        right_file_type="csv",
        output_file_type="parquet",
        left_delimiter=None,
        right_delimiter=None,
        output_delimiter=None,
        select_columns="*",
        where_condition=None,
        compression="zstd",
        append=False,
        show_stats=True,
        show_summary=True
    ):

        join_type=join_type.upper()

        valid_joins=["LEFT","RIGHT","INNER","FULL"]

        if join_type not in valid_joins:

            raise ValueError(
                f"join_type must be one of {valid_joins}"
            )

        left_reader=self.get_reader(
            left_file,
            left_file_type,
            left_delimiter
        )

        right_reader=self.get_reader(
            right_file,
            right_file_type,
            right_delimiter
        )

        where_clause=(
            f"WHERE {where_condition}"
            if where_condition else ""
        )

        query=f"""
        SELECT {select_columns}
        FROM {left_reader} l
        {join_type} JOIN {right_reader} r
        ON l.{left_join_key}=r.{right_join_key}
        {where_clause}
        """

        if show_stats:

            self.log("\nMERGE STARTED")

            self.log(
                f"Memory Limit : {self.memory_limit}"
            )

            self.log(
                f"Threads      : {self.threads}"
            )

            self.log(
                f"Join Type    : {join_type}"
            )

        start=time.time()

        stop_event=threading.Event()

        monitor_thread=threading.Thread(
            target=self.monitor_memory,
            args=(stop_event,)
        )

        monitor_thread.start()

        con=self.connect()

        try:

            # =================================================
            # PARQUET OUTPUT
            # =================================================

            if output_file_type.lower()=="parquet":

                if append and os.path.exists(output_file):

                    temp_table="temp_merge_table"

                    con.execute(f"""
                    CREATE TEMP TABLE {temp_table} AS
                    {query}
                    """)

                    con.execute(f"""
                    COPY (
                        SELECT * FROM read_parquet('{output_file}')
                        UNION ALL
                        SELECT * FROM {temp_table}
                    )
                    TO '{output_file}'
                    (
                        FORMAT PARQUET,
                        COMPRESSION '{compression}'
                    )
                    """)

                else:

                    con.execute(f"""
                    COPY (
                        {query}
                    )
                    TO '{output_file}'
                    (
                        FORMAT PARQUET,
                        COMPRESSION '{compression}'
                    )
                    """)

            # =================================================
            # CSV / TXT OUTPUT
            # =================================================

            elif output_file_type.lower() in ["csv","txt"]:

                if output_file_type.lower()=="txt":
                    output_delimiter=output_delimiter or "\t"

                else:
                    output_delimiter=output_delimiter or ","

                if append and os.path.exists(output_file):

                    temp_file=f"{output_file}.tmp"

                    con.execute(f"""
                    COPY (
                        {query}
                    )
                    TO '{temp_file}'
                    (
                        FORMAT CSV,
                        HEADER,
                        FORCE_QUOTE *,
                        DELIMITER '{output_delimiter}'
                    )
                    """)

                    with open(output_file,"a",encoding="utf-8") as main_file:
                        with open(temp_file,"r",encoding="utf-8") as temp:

                            next(temp)

                            for line in temp:
                                main_file.write(line)

                    os.remove(temp_file)

                else:

                    con.execute(f"""
                    COPY (
                        {query}
                    )
                    TO '{output_file}'
                    (
                        FORMAT CSV,
                        HEADER,
                        FORCE_QUOTE *,
                        DELIMITER '{output_delimiter}'
                    )
                    """)

            else:

                raise ValueError(
                    "Supported output: csv, txt, parquet"
                )

        finally:

            con.close()

            stop_event.set()

            monitor_thread.join()

        elapsed_minutes=(time.time()-start)/60

        output_size_gb=os.path.getsize(output_file)/(1024**3)

        # =====================================================
        # SUMMARY
        # =====================================================

        if show_summary:

            self.log("\nMERGE COMPLETED")

            self.log(
                f"Output File      : {output_file}"
            )

            self.log(
                f"Output Size      : "
                f"{output_size_gb:.2f} GB"
            )

            self.log(
                f"Time Taken       : "
                f"{elapsed_minutes:.2f} minutes"
            )

            self.log(
                f"Max Memory Usage : "
                f"{self.max_memory_used:.2f} GB"
            )

        return output_file


# =====================================================
# EXAMPLE
# =====================================================

merger=DuckDBMerger(
    memory_usage_percent=75,
    threads=8,
    verbose=True
)

merger.merge(
    left_file="sales.txt",
    right_file="customers.csv",
    output_file="final_output.txt",
    left_join_key="customer_id",
    right_join_key="cust_id",
    join_type="LEFT",
    left_file_type="txt",
    right_file_type="csv",
    output_file_type="txt",
    append=True,
    show_stats=False,
    show_summary=True
)
