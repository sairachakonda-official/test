import os
import time
import duckdb
import psutil
import threading


class UltraFastDuckDBMerger:

    def __init__(
        self,
        memory_usage_percent=95,
        threads=None,
        temp_directory="duckdb_temp",
        verbose=True
    ):
        self.verbose = verbose
        self.threads = threads or os.cpu_count()

        available_gb = (
            psutil.virtual_memory().available / (1024 ** 3)
        )

        usable_gb = max(
            int(available_gb * memory_usage_percent / 100),
            1
        )

        self.memory_limit = f"{usable_gb}GB"

        self.temp_directory = temp_directory

        os.makedirs(
            temp_directory,
            exist_ok=True
        )

    # =====================================================
    # LOGGER
    # =====================================================

    def log(self, *args):

        if self.verbose:
            print(*args)

    # =====================================================
    # MEMORY MONITOR
    # =====================================================

    def monitor_memory(
        self,
        stop_event,
        interval=0.1
    ):
        process = psutil.Process(os.getpid())

        self.max_memory_used_bytes = 0

        while not stop_event.is_set():

            try:

                memory = process.memory_info().rss

                if memory > self.max_memory_used_bytes:
                    self.max_memory_used_bytes = memory

            except Exception:
                pass

            time.sleep(interval)

    # =====================================================
    # CONNECTION
    # =====================================================

    def connect(self):

        con = duckdb.connect()

        con.execute(
            f"SET memory_limit='{self.memory_limit}'"
        )

        con.execute(
            f"SET threads={self.threads}"
        )

        con.execute(
            f"SET temp_directory='{self.temp_directory}'"
        )

        con.execute(
            "SET preserve_insertion_order=false"
        )

        con.execute(
            "SET enable_progress_bar=false"
        )

        con.execute(
            "PRAGMA disable_object_cache"
        )

        return con

    # =====================================================
    # FILE READER
    # =====================================================

    def get_reader(
        self,
        file_path,
        file_type,
        delimiter=None
    ):

        file_type = file_type.lower()

        if file_type == "parquet":

            return (
                f"read_parquet('{file_path}')"
            )

        delimiter = delimiter or (
            "\t" if file_type == "txt" else ","
        )

        return f"""
        read_csv(
            '{file_path}',
            delim='{delimiter}',
            header=true,
            ignore_errors=true,
            sample_size=2048,
            max_line_size=134217728,
            parallel=true,
            auto_detect=true
        )
        """

    # =====================================================
    # MERGE
    # =====================================================

    def merge(
        self,
        left_file,
        right_file,
        output_file,
        left_join_key,
        right_join_key,
        join_type="LEFT",
        left_file_type="csv",
        right_file_type="csv",
        left_delimiter=None,
        right_delimiter=None,
        select_columns="*",
        where_condition=None,
        compression="SNAPPY"
    ):

        start = time.time()

        stop_event = threading.Event()

        memory_thread = threading.Thread(
            target=self.monitor_memory,
            args=(stop_event,),
            daemon=True
        )

        memory_thread.start()

        con = self.connect()

        left_reader = self.get_reader(
            left_file,
            left_file_type,
            left_delimiter
        )

        right_reader = self.get_reader(
            right_file,
            right_file_type,
            right_delimiter
        )

        where_clause = (
            f"WHERE {where_condition}"
            if where_condition else ""
        )

        left_size_gb = (
            os.path.getsize(left_file) /
            (1024 ** 3)
        )

        right_size_gb = (
            os.path.getsize(right_file) /
            (1024 ** 3)
        )

        query = f"""
        COPY (
            SELECT {select_columns}
            FROM {left_reader} l
            {join_type} JOIN {right_reader} r
            ON l.{left_join_key}=r.{right_join_key}
            {where_clause}
        )
        TO '{output_file}'
        (
            FORMAT PARQUET,
            COMPRESSION {compression},
            ROW_GROUP_SIZE 1000000
        )
        """

        self.log(
            "Running ultra fast merge..."
        )

        con.execute(query)

        output_rows = con.execute(
            f"""
            SELECT COUNT(*)
            FROM read_parquet('{output_file}')
            """
        ).fetchone()[0]

        con.close()

        stop_event.set()

        memory_thread.join()

        elapsed_seconds = (
            time.time() - start
        )

        output_size_gb = (
            os.path.getsize(output_file) /
            (1024 ** 3)
        )

        max_memory_used_gb = (
            self.max_memory_used_bytes /
            (1024 ** 3)
        )

        stats = {

            "status": "success",

            "join_type": join_type,

            "left_file": left_file,

            "right_file": right_file,

            "left_file_type": left_file_type,

            "right_file_type": right_file_type,

            "left_file_size_gb": round(
                left_size_gb,
                2
            ),

            "right_file_size_gb": round(
                right_size_gb,
                2
            ),

            "output_file": output_file,

            "output_size_gb": round(
                output_size_gb,
                2
            ),

            "output_rows": output_rows,

            "execution_time_seconds": round(
                elapsed_seconds,
                2
            ),

            "execution_time_minutes": round(
                elapsed_seconds / 60,
                2
            ),

            "max_memory_used_gb": round(
                max_memory_used_gb,
                2
            ),

            "memory_limit": self.memory_limit,

            "threads_used": self.threads,

            "compression": compression
        }

        return stats


# =====================================================
# EXAMPLE
# =====================================================

merger = UltraFastDuckDBMerger(
    memory_usage_percent=95,
    threads=os.cpu_count(),
    verbose=True
)

stats = merger.merge(
    left_file="sales.csv",
    right_file="customers.txt",
    output_file="final_output.parquet",
    left_join_key="customer_id",
    right_join_key="cust_id",
    join_type="LEFT",
    left_file_type="csv",
    right_file_type="txt",
    left_delimiter=",",
    right_delimiter="\t",
    compression="SNAPPY"
)

print(stats)




import os
import duckdb


def merge_parquet_files(
    input_folder: str,
    output_file: str,
    compression: str = "SNAPPY",
    threads: int = 8,
    memory_limit: str = "16GB",
    delete_source: bool = False,
) -> None:
    con = duckdb.connect()

    con.execute(f"SET threads={threads}")
    con.execute(f"SET memory_limit='{memory_limit}'")

    parquet_path = os.path.join(input_folder, "*.parquet").replace("\\", "/")
    output_file = output_file.replace("\\", "/")

    con.execute(f"""
        COPY (
            SELECT *
            FROM read_parquet('{parquet_path}')
        )
        TO '{output_file}'
        (FORMAT PARQUET, COMPRESSION {compression});
    """)

    con.close()

    if delete_source:
        for file in os.listdir(input_folder):
            if file.endswith(".parquet"):
                os.remove(os.path.join(input_folder, file))

        if not os.listdir(input_folder):
            os.rmdir(input_folder)
