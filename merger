import duckdb
import psutil
import os
import time


class UltraFastDuckDBMerger:

    def __init__(
        self,
        memory_usage_percent=95,
        threads=None,
        temp_directory="duckdb_temp",
        verbose=True
    ):

        self.verbose=verbose

        self.threads=threads or os.cpu_count()

        available_gb=(
            psutil.virtual_memory().available
            /(1024**3)
        )

        usable_gb=max(
            int(
                available_gb
                * memory_usage_percent
                /100
            ),
            1
        )

        self.memory_limit=f"{usable_gb}GB"

        self.temp_directory=temp_directory

        os.makedirs(
            temp_directory,
            exist_ok=True
        )

    # =====================================================
    # LOGGER
    # =====================================================

    def log(self,*args):

        if self.verbose:
            print(*args)

    # =====================================================
    # CONNECTION
    # =====================================================

    def connect(self):

        con=duckdb.connect()

        # -------------------------------------------------
        # MEMORY + THREADS
        # -------------------------------------------------

        con.execute(
            f"SET memory_limit='{self.memory_limit}'"
        )

        con.execute(
            f"SET threads={self.threads}"
        )

        con.execute(
            f"SET temp_directory='{self.temp_directory}'"
        )

        # -------------------------------------------------
        # PERFORMANCE SETTINGS
        # -------------------------------------------------

        con.execute(
            "SET preserve_insertion_order=false"
        )

        con.execute(
            "SET enable_progress_bar=false"
        )

        con.execute(
            "PRAGMA disable_object_cache"
        )

        return con

    # =====================================================
    # FILE READER
    # =====================================================

    def get_reader(
        self,
        file_path,
        file_type,
        delimiter=None
    ):

        file_type=file_type.lower()

        # -------------------------------------------------
        # PARQUET
        # -------------------------------------------------

        if file_type=="parquet":

            return f"""
            read_parquet(
                '{file_path}'
            )
            """

        # -------------------------------------------------
        # TXT
        # -------------------------------------------------

        if file_type=="txt":

            delimiter=delimiter or "\t"

        # -------------------------------------------------
        # CSV
        # -------------------------------------------------

        else:

            delimiter=delimiter or ","

        # -------------------------------------------------
        # FAST CSV READER
        # -------------------------------------------------

        return f"""
        read_csv(
            '{file_path}',
            delim='{delimiter}',
            header=true,
            ignore_errors=true,
            sample_size=2048,
            max_line_size=134217728,
            parallel=true,
            auto_detect=true
        )
        """

    # =====================================================
    # MERGE
    # =====================================================

    def merge(
        self,
        left_file,
        right_file,
        output_file,
        left_join_key,
        right_join_key,
        join_type="LEFT",
        left_file_type="csv",
        right_file_type="csv",
        left_delimiter=None,
        right_delimiter=None,
        select_columns="*",
        where_condition=None,
        compression="SNAPPY"
    ):

        start=time.time()

        con=self.connect()

        left_reader=self.get_reader(
            left_file,
            left_file_type,
            left_delimiter
        )

        right_reader=self.get_reader(
            right_file,
            right_file_type,
            right_delimiter
        )

        where_clause=(
            f"WHERE {where_condition}"
            if where_condition else ""
        )

        # =================================================
        # QUERY
        # =================================================

        query=f"""
        COPY (

            SELECT {select_columns}

            FROM {left_reader} l

            {join_type} JOIN {right_reader} r

            ON l.{left_join_key}=r.{right_join_key}

            {where_clause}

        )

        TO '{output_file}'

        (
            FORMAT PARQUET,
            COMPRESSION {compression},
            ROW_GROUP_SIZE 1000000
        )
        """

        self.log("Running ultra fast merge...")

        con.execute(query)

        con.close()

        elapsed=(time.time()-start)/60

        output_size=(
            os.path.getsize(output_file)
            /(1024**3)
        )

        self.log(
            f"Completed in {elapsed:.2f} minutes"
        )

        self.log(
            f"Output Size : {output_size:.2f} GB"
        )

        return output_file


# =====================================================
# EXAMPLE
# =====================================================

merger=UltraFastDuckDBMerger(
    memory_usage_percent=95,
    threads=os.cpu_count(),
    verbose=True
)

merger.merge(
    left_file="sales.csv",
    right_file="customers.txt",
    output_file="final_output.parquet",
    left_join_key="customer_id",
    right_join_key="cust_id",
    join_type="LEFT",
    left_file_type="csv",
    right_file_type="txt",
    left_delimiter=",",
    right_delimiter="\t",
    compression="SNAPPY"
)
