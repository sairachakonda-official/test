import os,gc,time,duckdb,psutil
from datetime import datetime
from concurrent.futures import ProcessPoolExecutor,as_completed

# =============================================================================
# CONFIG
# =============================================================================

INPUT_FOLDER="input_parquet"
ID_MAP_FILE="id_map/id_map.parquet"
OUTPUT_FOLDER="partitioned_output"

JOIN_KEY="client_data1"
BUCKET_COLUMN="bucket_number"

# KEEP join_id INSIDE FINAL PARQUET
JOIN_ID_COLUMN="join_id"

DROP_COLUMNS={
    "unnecessary_col1",
    "unnecessary_col2"
}

DROP_PREFIXES={
    "tmp_",
    "debug_",
    "unused_"
}

COMPRESSION="SNAPPY"

# =============================================================================
# SYSTEM
# =============================================================================

AVAILABLE_RAM_GB=psutil.virtual_memory().available/(1024**3)

if AVAILABLE_RAM_GB>=64:
    MAX_WORKERS=4
elif AVAILABLE_RAM_GB>=32:
    MAX_WORKERS=3
elif AVAILABLE_RAM_GB>=16:
    MAX_WORKERS=2
else:
    MAX_WORKERS=1

# multiprocessing enabled
DUCKDB_THREADS=1

SETTINGS_PROFILES=[
    {
        "name":"FAST",
        "threads":1,
        "row_group_size":1000000,
        "memory_limit":"4GB"
    },
    {
        "name":"SAFE",
        "threads":1,
        "row_group_size":250000,
        "memory_limit":"2GB"
    },
    {
        "name":"ULTRA_SAFE",
        "threads":1,
        "row_group_size":100000,
        "memory_limit":"1GB"
    }
]

LOG_FOLDER="logs"

# =============================================================================
# SETUP
# =============================================================================

os.makedirs(OUTPUT_FOLDER,exist_ok=True)
os.makedirs(LOG_FOLDER,exist_ok=True)

LOG_FILE=os.path.join(
    LOG_FOLDER,
    f"log_{datetime.now().strftime('%Y%m%d_%H%M%S')}.txt"
)

# =============================================================================
# LOG
# =============================================================================

def log(msg):

    timestamp=datetime.now().strftime(
        "%Y-%m-%d %H:%M:%S"
    )

    final_msg=f"[{timestamp}] {msg}"

    print(final_msg,flush=True)

    with open(LOG_FILE,"a",encoding="utf-8") as f:
        f.write(final_msg+"\n")

# =============================================================================
# MEMORY
# =============================================================================

def print_memory():

    mem=psutil.virtual_memory()

    used=mem.used/(1024**3)
    avail=mem.available/(1024**3)
    total=mem.total/(1024**3)

    log(
        f"RAM Used={used:.2f}GB "
        f"Avail={avail:.2f}GB "
        f"Total={total:.2f}GB"
    )

# =============================================================================
# CLEANUP
# =============================================================================

def cleanup(con=None):

    try:
        if con:
            con.close()
    except Exception as e:
        log(f"Cleanup failed={str(e)}")

    gc.collect()

# =============================================================================
# FILE DISCOVERY
# =============================================================================

def get_parquet_files(folder):

    parquet_files=[]

    for root,_,files in os.walk(folder):

        for file in files:

            if file.endswith(".parquet"):

                parquet_files.append(
                    os.path.join(root,file)
                )

    parquet_files.sort()

    return parquet_files

# =============================================================================
# PROCESS FILE
# =============================================================================

def process_file(file_path,idx,total_files):

    file_name=os.path.basename(file_path)

    log("="*80)
    log(f"[{idx}/{total_files}] {file_name}")
    log("="*80)

    file_start=time.time()

    print_memory()

    try:

        file_size_gb=os.path.getsize(file_path)/(1024**3)

        log(f"Input Size={file_size_gb:.2f}GB")

    except:
        pass

    con=duckdb.connect()

    try:

        # ---------------------------------------------------------------------
        # GLOBAL SETTINGS
        # ---------------------------------------------------------------------

        con.execute(
            "PRAGMA preserve_insertion_order=false"
        )

        con.execute(
            "PRAGMA parquet_metadata_cache=true"
        )

        # ---------------------------------------------------------------------
        # LOAD ID MAP ONCE
        # ---------------------------------------------------------------------

        log("Loading ID map")

        con.execute(f"""
        CREATE TEMP TABLE id_map AS
        SELECT
            {JOIN_KEY},
            {JOIN_ID_COLUMN},
            {BUCKET_COLUMN}
        FROM read_parquet('{ID_MAP_FILE}')
        """)

        # ---------------------------------------------------------------------
        # ROW COUNT
        # ---------------------------------------------------------------------

        total_rows=con.execute(f"""
        SELECT COUNT(*)
        FROM read_parquet('{file_path}')
        """).fetchone()[0]

        log(f"Rows={total_rows:,}")

        # ---------------------------------------------------------------------
        # READ SCHEMA
        # ---------------------------------------------------------------------

        schema_query=f"""
        SELECT *
        FROM read_parquet('{file_path}')
        LIMIT 0
        """

        source_columns=[
            desc[0]
            for desc in con.execute(
                schema_query
            ).description
        ]

        log(
            f"Source Columns="
            f"{len(source_columns)}"
        )

        # ---------------------------------------------------------------------
        # FILTER COLUMNS
        # ---------------------------------------------------------------------

        filtered_columns=[]

        for col in source_columns:

            if col in DROP_COLUMNS:
                continue

            skip=False

            for prefix in DROP_PREFIXES:

                if col.startswith(prefix):
                    skip=True
                    break

            if skip:
                continue

            filtered_columns.append(
                f"src.{col}"
            )

        log(
            f"Filtered Columns="
            f"{len(filtered_columns)}"
        )

        select_sql=",\n".join(filtered_columns)

        # ---------------------------------------------------------------------
        # JOIN + PARTITION
        # ---------------------------------------------------------------------

        success=False
        last_error=None

        for profile in SETTINGS_PROFILES:

            try:

                log("-"*80)

                log(
                    f"PROFILE={profile['name']} "
                    f"THREADS={profile['threads']} "
                    f"MEMORY={profile['memory_limit']} "
                    f"ROW_GROUP={profile['row_group_size']}"
                )

                con.execute(
                    f"""
                    PRAGMA threads=
                    {profile['threads']}
                    """
                )

                con.execute(
                    f"""
                    PRAGMA memory_limit=
                    '{profile["memory_limit"]}'
                    """
                )

                partition_start=time.time()

                query=f"""
                COPY (
                    SELECT

                        {select_sql},

                        map.{JOIN_ID_COLUMN},

                        map.{BUCKET_COLUMN},

                        map.{BUCKET_COLUMN}
                        AS bucket_number_file

                    FROM read_parquet('{file_path}') src

                    INNER JOIN id_map map

                    ON src.{JOIN_KEY}=map.{JOIN_KEY}
                )
                TO '{OUTPUT_FOLDER}'
                (
                    FORMAT PARQUET,

                    PARTITION_BY ({BUCKET_COLUMN}),

                    OVERWRITE_OR_IGNORE FALSE,

                    PER_THREAD_OUTPUT FALSE,

                    ROW_GROUP_SIZE
                    {profile["row_group_size"]},

                    COMPRESSION {COMPRESSION}
                )
                """

                con.execute(query)

                elapsed=time.time()-partition_start

                log(
                    f"{profile['name']} SUCCESS "
                    f"{elapsed:.2f} sec"
                )

                success=True

                break

            except Exception as e:

                last_error=str(e)

                log(
                    f"{profile['name']} FAILED"
                )

                log(last_error)

                error_lower=last_error.lower()

                memory_keywords=[
                    "memory",
                    "oom",
                    "out of memory",
                    "allocation",
                ]

                is_memory_error=any(
                    x in error_lower
                    for x in memory_keywords
                )

                if is_memory_error:

                    log(
                        "Memory issue -> "
                        "fallback profile"
                    )

                    gc.collect()

                else:

                    raise

        if not success:

            raise Exception(
                f"All profiles failed: "
                f"{last_error}"
            )

        total_elapsed=time.time()-file_start

        print_memory()

        log(
            f"Completed {file_name} "
            f"in {total_elapsed:.2f} sec"
        )

    except Exception as e:

        log(
            f"ERROR PROCESSING "
            f"{file_name}"
        )

        log(str(e))

    finally:

        cleanup(con)

        print_memory()

        log("="*80)
        log(f"END FILE {file_name}")
        log("="*80)

# =============================================================================
# MAIN
# =============================================================================

def main():

    total_start=time.time()

    log("="*80)
    log("PARALLEL JOIN + PARTITION PIPELINE")
    log("="*80)

    log(f"Workers={MAX_WORKERS}")
    log(f"DuckDB Threads={DUCKDB_THREADS}")

    print_memory()

    if not os.path.exists(ID_MAP_FILE):

        log(f"ID Map missing={ID_MAP_FILE}")

        return

    files=get_parquet_files(INPUT_FOLDER)

    total_files=len(files)

    log(f"Files Found={total_files}")

    if total_files==0:
        return

    with ProcessPoolExecutor(
        max_workers=MAX_WORKERS
    ) as executor:

        futures=[]

        for idx,file_path in enumerate(files,1):

            futures.append(

                executor.submit(
                    process_file,
                    file_path,
                    idx,
                    total_files
                )
            )

        for future in as_completed(futures):

            try:

                future.result()

            except Exception as e:

                log(
                    f"Parallel worker failed="
                    f"{str(e)}"
                )

    total_elapsed=time.time()-total_start

    log("="*80)
    log("ALL FILES COMPLETED")
    log("="*80)

    log(
        f"Total Pipeline Time="
        f"{total_elapsed:.2f} sec"
    )

    print_memory()

    log(f"Log File={LOG_FILE}")

# =============================================================================
# ENTRY
# =============================================================================

if __name__=="__main__":
    main()
